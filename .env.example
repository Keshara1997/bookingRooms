# Application
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001

# PostgreSQL
POSTGRES_DB=bookingrooms_dev
POSTGRES_USER=bookingrooms
POSTGRES_PASSWORD=bookingrooms_local_dev_password

DATABASE_URL=postgresql://bookingrooms:bookingrooms_local_dev_password@localhost:5432/bookingrooms_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bookingrooms_redis_local_password
REDIS_URL=redis://:bookingrooms_redis_local_password@localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# JWT - replace before application authentication is implemented
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
