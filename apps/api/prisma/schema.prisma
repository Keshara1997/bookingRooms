
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum MembershipRole {
  OWNER
  ADMIN
  HOTEL_MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  ACCOUNTANT
}

enum HotelStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RoomBlockReason {
  MAINTENANCE
  REPAIR
  OUT_OF_SERVICE
  MANAGEMENT_USE
  OTHER
}

enum RoomBlockStatus {
  ACTIVE
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  WEBSITE
  ADMIN
  WALK_IN
  PHONE
  THIRD_PARTY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
  NON_REFUNDABLE
}

// ============================================
// TENANT
// ============================================

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  email  String
  phone  String?
  status TenantStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  hotels            Hotel[]
  branches          Branch[]
  roomTypes         RoomType[]
  rooms             Room[]
  guests            Guest[]
  reservations      Reservation[]
  reservationRooms  ReservationRoom[]
  payments          Payment[]
  paymentRefunds    PaymentRefund[]
  invoices          Invoice[]
  amenities         Amenity[]
  housekeepingTasks HousekeepingTask[]
  auditLogs         AuditLog[]

  // Pricing
  ratePlans  RatePlan[]
  dailyRates DailyRate[]

  // Inventory
  roomInventories RoomInventory[]
  roomBlocks      RoomBlock[]

  @@index([status])
  @@map("tenants")
}

// ============================================
// USERS AND TENANT MEMBERSHIPS
// ============================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  status       UserStatus @default(ACTIVE)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  sessions      AuthSession[]
  assignedTasks HousekeepingTask[]
  auditLogs     AuditLog[]

  @@index([status])
  @@map("users")
}

model Membership {
  id       String         @id @default(cuid())
  tenantId String
  userId   String
  role     MembershipRole @default(RECEPTIONIST)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@map("memberships")
}

// ============================================
// HOTELS AND BRANCHES
// ============================================

model Hotel {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?     @db.Text
  email       String?
  phone       String?
  website     String?
  timezone    String      @default("Asia/Colombo")
  currency    String      @default("LKR") @db.VarChar(3)
  starRating  Int?
  status      HotelStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches     Branch[]
  roomTypes    RoomType[]
  reservations Reservation[]

  // Pricing
  ratePlans RatePlan[]

  // Inventory
  roomInventories RoomInventory[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("hotels")
}

model Branch {
  id         String  @id @default(cuid())
  tenantId   String
  hotelId    String
  name       String
  code       String
  address    String? @db.Text
  city       String?
  country    String?
  postalCode String?
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms        Room[]
  reservations Reservation[]

  // Inventory
  roomInventories RoomInventory[]

  @@unique([hotelId, code])
  @@index([tenantId, hotelId])
  @@map("branches")
}

// ============================================
// ROOM TYPES AND ROOMS
// ============================================

model RoomType {
  id          String   @id @default(cuid())
  tenantId    String
  hotelId     String
  name        String
  code        String
  description String?  @db.Text
  maxAdults   Int      @default(2)
  maxChildren Int      @default(0)
  basePrice   Decimal  @default(0) @db.Decimal(12, 2)
  size        Decimal? @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms            Room[]
  reservationRooms ReservationRoom[]
  amenities        RoomTypeAmenity[]

  // Pricing
  ratePlans RatePlan[]

  // Inventory
  roomInventories RoomInventory[]

  @@unique([hotelId, code])
  @@index([tenantId, hotelId])
  @@map("room_types")
}

model Room {
  id         String     @id @default(cuid())
  tenantId   String
  branchId   String
  roomTypeId String
  roomNumber String
  floor      Int?
  status     RoomStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservationRooms  ReservationRoom[]
  housekeepingTasks HousekeepingTask[]

  // Inventory blocking
  roomBlocks RoomBlock[]

  @@unique([branchId, roomNumber])
  @@index([tenantId, status])
  @@index([branchId, status])
  @@map("rooms")
}

// ============================================
// ROOM INVENTORY
// ============================================

model RoomInventory {
  id         String @id @default(cuid())
  tenantId   String
  hotelId    String
  branchId   String
  roomTypeId String

  date DateTime @db.Date

  totalRooms    Int @default(0)
  reservedRooms Int @default(0)
  blockedRooms  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@unique([branchId, roomTypeId, date])
  @@index([tenantId, date])
  @@index([hotelId, date])
  @@index([roomTypeId, date])
  @@map("room_inventories")
}

// ============================================
// ROOM BLOCKS
// ============================================

model RoomBlock {
  id       String @id @default(cuid())
  tenantId String
  roomId   String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  reason RoomBlockReason @default(MAINTENANCE)
  status RoomBlockStatus @default(ACTIVE)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([roomId, startDate, endDate])
  @@map("room_blocks")
}

// ============================================
// RATE PLANS
// ============================================

model RatePlan {
  id          String  @id @default(cuid())
  tenantId    String
  hotelId     String
  roomTypeId  String

  name        String
  code        String
  description String? @db.Text

  mealPlan                  MealPlan           @default(ROOM_ONLY)
  cancellationPolicy        CancellationPolicy @default(FLEXIBLE)
  cancellationDeadlineHours Int?
  cancellationFeePercent    Decimal            @default(0) @db.Decimal(5, 2)

  minStayNights Int     @default(1)
  maxStayNights Int?
  isRefundable  Boolean @default(true)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  dailyRates       DailyRate[]
  reservationRooms ReservationRoom[]

  @@unique([hotelId, roomTypeId, code])
  @@index([tenantId, hotelId, roomTypeId, isActive])
  @@map("rate_plans")
}

// ============================================
// DAILY RATES
// ============================================

model DailyRate {
  id         String   @id @default(cuid())
  tenantId   String
  ratePlanId String

  date  DateTime @db.Date
  price Decimal  @db.Decimal(12, 2)

  minStayNights Int?
  maxStayNights Int?

  isClosed          Boolean @default(false)
  closedToArrival   Boolean @default(false)
  closedToDeparture Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
  @@index([tenantId, date])
  @@index([ratePlanId, date])
  @@map("daily_rates")
}

// ============================================
// GUESTS
// ============================================

model Guest {
  id        String  @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String? @db.Text
  country   String?
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("guests")
}

// ============================================
// RESERVATIONS
// ============================================

model Reservation {
  id               String            @id @default(cuid())
  tenantId         String
  hotelId          String
  branchId         String
  guestId          String
  confirmationCode String
  checkIn          DateTime          @db.Date
  checkOut         DateTime          @db.Date
  adults           Int               @default(1)
  children         Int               @default(0)
  status           ReservationStatus @default(PENDING)
  source           ReservationSource @default(WEBSITE)
  currency         String            @default("LKR") @db.VarChar(3)
  totalAmount      Decimal           @default(0) @db.Decimal(12, 2)
  specialRequests  String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hotel    Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  guest    Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  rooms    ReservationRoom[]
  payments Payment[]
  invoices Invoice[]

  @@unique([tenantId, confirmationCode])
  @@index([tenantId, status])
  @@index([hotelId, checkIn, checkOut])
  @@index([branchId, checkIn, checkOut])
  @@index([guestId])
  @@map("reservations")
}

model ReservationRoom {
  id            String   @id @default(cuid())
  tenantId      String
  reservationId String
  roomTypeId    String
  roomId        String?
  ratePlanId    String?
  nightlyRate   Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room        Room?       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  ratePlan    RatePlan?   @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)

  @@index([tenantId, reservationId])
  @@index([roomId])
  @@index([ratePlanId])
  @@map("reservation_rooms")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  reservationId String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("LKR") @db.VarChar(3)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  provider      String?
  transactionId String?
  paidAt        DateTime?
  notes         String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  refunds     PaymentRefund[]

  @@index([tenantId, status])
  @@index([reservationId])
  @@map("payments")
}

model PaymentRefund {
  id               String       @id @default(cuid())
  tenantId         String
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @db.VarChar(3)
  status           RefundStatus @default(PENDING)
  provider         String?
  providerRefundId String?
  reason           String?      @db.Text
  idempotencyKey   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@index([tenantId, paymentId])
  @@map("payment_refunds")
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  reservationId String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("LKR") @db.VarChar(3)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  issuedAt      DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  lineItems   InvoiceLineItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, reservationId])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ============================================
// AMENITIES
// ============================================

model Amenity {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  icon      String?
  createdAt DateTime @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomTypes RoomTypeAmenity[]

  @@unique([tenantId, name])
  @@map("amenities")
}

model RoomTypeAmenity {
  id         String @id @default(cuid())
  roomTypeId String
  amenityId  String

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

// ============================================
// HOUSEKEEPING
// ============================================

model HousekeepingTask {
  id           String             @id @default(cuid())
  tenantId     String
  roomId       String
  assignedToId String?
  status       HousekeepingStatus @default(PENDING)
  description  String?            @db.Text
  scheduledAt  DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  room       Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignedTo User?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([roomId])
  @@map("housekeeping_tasks")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================
// AUTH SESSIONS
// ============================================

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}
